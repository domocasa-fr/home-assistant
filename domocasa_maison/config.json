{
  "name": "Domocasa Maison",
  "version": "0.1.2",
  "slug": "domocasa_maison",
  "description": "Pilotez votre maison depuis l'application Domocasa, sans rien ouvrir sur Internet.",
  "url": "https://domocasa.fr",
  "arch": ["aarch64", "amd64"],
  "image": "ghcr.io/domocasa-fr/{arch}-addon-domocasa-maison",
  "startup": "application",
  "boot": "auto",
  "init": true,
  "stage": "experimental",
  "host_network": true,
  "ports": {
    "8788/tcp": 8788
  },
  "ports_description": {
    "8788/tcp": "Connexion des applications Domocasa depuis le réseau de la maison"
  },
  "homeassistant_api": true,
  "hassio_api": true,
  "hassio_role": "default",
  "ingress": true,
  "ingress_port": 0,
  "panel_title": "Domocasa",
  "panel_icon": "mdi:home-automation",
  "panel_admin": true,
  "map": [
    {
      "type": "addon_config",
      "read_only": false
    }
  ],
  "watchdog": "tcp://[HOST]:[PORT:8788]",
  "backup": "hot",
  "backup_exclude": ["controle.sock", "*.lock"],
  "options": {
    "lieu": "Maison",
    "masquer": [],
    "arrosage": [],
    "annonce_mdns": true,
    "niveau_journal": "info"
  },
  "schema": {
    "lieu": "str",
    "masquer": ["str"],
    "arrosage": ["str"],
    "annonce_mdns": "bool",
    "adresse_locale": "match(^ws://[^/\\s]+/v1$)?",
    "relais_url": "url?",
    "cloud_url": "url?",
    "niveau_journal": "list(erreur|avertissement|info|detail)",
    "alarme_code": "password?",
    "alarme_entite": "str?"
  }
}
